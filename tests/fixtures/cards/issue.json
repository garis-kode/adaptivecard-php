{
    "$schema": "https://adaptivecards.io/schemas/adaptive-card.json",
    "type": "AdaptiveCard",
    "version": "1.6",
    "speak": "Version 2.2 performance optimization",
    "body": [
        {
            "type": "RichTextBlock",
            "inlines": [
                {
                    "type": "TextRun",
                    "text": "Android Scrum Project / SSP-98",
                    "size": "Small",
                    "selectAction": {
                        "type": "Action.OpenUrl",
                        "url": "https://adaptivecards.io"
                    }
                }
            ]
        },
        {
            "type": "ColumnSet",
            "spacing": "Small",
            "columns": [
                {
                    "type": "Column",
                    "width": "auto",
                    "items": [
                        {
                            "type": "Icon",
                            "name": "Branch",
                            "color": "Accent"
                        }
                    ]
                },
                {
                    "type": "Column",
                    "width": "stretch",
                    "verticalContentAlignment": "Center",
                    "spacing": "Small",
                    "items": [
                        {
                            "type": "TextBlock",
                            "text": "Version 2.2 Performance Optimization",
                            "size": "Large",
                            "weight": "Bolder",
                            "wrap": true
                        }
                    ]
                }
            ]
        },
        {
            "type": "Table",
            "targetWidth": "atLeast:Narrow",
            "columns": [
                {
                    "width": 1
                },
                {
                    "width": 2
                }
            ],
            "rows": [
                {
                    "type": "TableRow",
                    "cells": [
                        {
                            "type": "TableCell",
                            "verticalContentAlignment": "Center",
                            "items": [
                                {
                                    "type": "TextBlock",
                                    "text": "Status",
                                    "wrap": true,
                                    "weight": "Bolder"
                                }
                            ]
                        },
                        {
                            "type": "TableCell",
                            "verticalContentAlignment": "Center",
                            "items": [
                                {
                                    "type": "TextBlock",
                                    "text": "Waiting for Review",
                                    "wrap": true
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "TableRow",
                    "cells": [
                        {
                            "type": "TableCell",
                            "items": [
                                {
                                    "type": "TextBlock",
                                    "text": "Due Date",
                                    "wrap": true,
                                    "weight": "Bolder"
                                }
                            ]
                        },
                        {
                            "type": "TableCell",
                            "items": [
                                {
                                    "type": "TextBlock",
                                    "text": "May 21, 2023",
                                    "wrap": true
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "TableRow",
                    "cells": [
                        {
                            "type": "TableCell",
                            "verticalContentAlignment": "Center",
                            "items": [
                                {
                                    "type": "TextBlock",
                                    "text": "Priority",
                                    "wrap": true,
                                    "weight": "Bolder"
                                }
                            ]
                        },
                        {
                            "type": "TableCell",
                            "verticalContentAlignment": "Center",
                            "items": [
                                {
                                    "type": "ColumnSet",
                                    "spacing": "Small",
                                    "columns": [
                                        {
                                            "type": "Column",
                                            "width": "auto",
                                            "items": [
                                                {
                                                    "type": "Icon",
                                                    "name": "Flag",
                                                    "color": "Attention",
                                                    "size": "xSmall",
                                                    "horizontalAlignment": "Center"
                                                }
                                            ]
                                        },
                                        {
                                            "type": "Column",
                                            "width": "stretch",
                                            "spacing": "Small",
                                            "items": [
                                                {
                                                    "type": "TextBlock",
                                                    "text": "Critical",
                                                    "color": "Attention",
                                                    "wrap": true,
                                                    "spacing": "Small"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "TableRow",
                    "cells": [
                        {
                            "type": "TableCell",
                            "verticalContentAlignment": "Center",
                            "items": [
                                {
                                    "type": "TextBlock",
                                    "text": "Assigned To",
                                    "wrap": true,
                                    "weight": "Bolder"
                                }
                            ]
                        },
                        {
                            "type": "TableCell",
                            "items": [
                                {
                                    "type": "ColumnSet",
                                    "columns": [
                                        {
                                            "type": "Column",
                                            "width": "auto",
                                            "verticalContentAlignment": "Center",
                                            "horizontalAlignment": "Center",
                                            "items": [
                                                {
                                                    "type": "Image",
                                                    "url": "https://raw.githubusercontent.com/OfficeDev/Microsoft-Teams-Card-Samples/main/samples/issue/assets/avatar.png",
                                                    "width": "16px"
                                                }
                                            ]
                                        },
                                        {
                                            "type": "Column",
                                            "width": "stretch",
                                            "spacing": "Small",
                                            "items": [
                                                {
                                                    "type": "TextBlock",
                                                    "text": "Charlotte Waltson",
                                                    "wrap": true
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ],
            "firstRowAsHeaders": false,
            "showGridLines": false
        },
        {
            "type": "Container",
            "targetWidth": "VeryNarrow",
            "items": [
                {
                    "type": "TextBlock",
                    "text": "Status",
                    "weight": "Bolder",
                    "wrap": true
                },
                {
                    "type": "TextBlock",
                    "text": "Waiting for Review",
                    "wrap": true,
                    "spacing": "None"
                },
                {
                    "type": "TextBlock",
                    "text": "Due Date",
                    "weight": "Bolder",
                    "wrap": true,
                    "spacing": "Small"
                },
                {
                    "type": "TextBlock",
                    "text": "May 21, 2023",
                    "wrap": true,
                    "spacing": "None"
                },
                {
                    "type": "TextBlock",
                    "text": "Priority",
                    "weight": "Bolder",
                    "wrap": true,
                    "spacing": "Small"
                },
                {
                    "type": "ColumnSet",
                    "spacing": "None",
                    "columns": [
                        {
                            "type": "Column",
                            "width": "auto",
                            "verticalContentAlignment": "Center",
                            "items": [
                                {
                                    "type": "Icon",
                                    "name": "Flag",
                                    "color": "Attention",
                                    "size": "xSmall",
                                    "horizontalAlignment": "Center"
                                }
                            ]
                        },
                        {
                            "type": "Column",
                            "width": "stretch",
                            "spacing": "Small",
                            "items": [
                                {
                                    "type": "TextBlock",
                                    "text": "Critical",
                                    "color": "Attention",
                                    "wrap": true,
                                    "spacing": "Small"
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "TextBlock",
                    "text": "Assigned To",
                    "weight": "Bolder",
                    "wrap": true,
                    "spacing": "Small"
                },
                {
                    "type": "ColumnSet",
                    "spacing": "None",
                    "columns": [
                        {
                            "type": "Column",
                            "width": "auto",
                            "verticalContentAlignment": "Center",
                            "horizontalAlignment": "Center",
                            "items": [
                                {
                                    "type": "Image",
                                    "url": "https://raw.githubusercontent.com/OfficeDev/Microsoft-Teams-Card-Samples/main/samples/issue/assets/avatar.png",
                                    "width": "16px"
                                }
                            ]
                        },
                        {
                            "type": "Column",
                            "width": "stretch",
                            "spacing": "Small",
                            "items": [
                                {
                                    "type": "TextBlock",
                                    "text": "Charlotte Waltson",
                                    "wrap": true
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "type": "ActionSet",
            "spacing": "ExtraLarge",
            "targetWidth": "atLeast:Narrow",
            "actions": [
                {
                    "type": "Action.OpenUrl",
                    "url": "https://adaptivecards.io/",
                    "title": "Comment"
                },
                {
                    "type": "Action.OpenUrl",
                    "url": "https://adaptivecards.io/",
                    "title": "Edit Issue"
                }
            ]
        },
        {
            "type": "ActionSet",
            "spacing": "ExtraLarge",
            "targetWidth": "VeryNarrow",
            "actions": [
                {
                    "type": "Action.OpenUrl",
                    "url": "https://adaptivecards.io/",
                    "title": "Comment"
                },
                {
                    "type": "Action.OpenUrl",
                    "url": "https://adaptivecards.io/",
                    "iconUrl": "icon:Edit"
                }
            ]
        }
    ]
}
