{
    "name": "garis-kode/adaptivecard-php",
    "description": "Fluent PHP builder that programmatically constructs Microsoft Adaptive Card (v1.6) JSON payloads.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "adaptivecards",
        "adaptive-cards",
        "microsoft-teams",
        "teams",
        "json",
        "builder"
    ],
    "homepage": "https://github.com/garis-kode/adaptivecard-php",
    "support": {
        "issues": "https://github.com/garis-kode/adaptivecard-php/issues",
        "source": "https://github.com/garis-kode/adaptivecard-php"
    },
    "authors": [
        {
            "name": "Garis Kode",
            "email": "office@gariskode.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^2.1 || ^2.3",
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "autoload": {
        "psr-4": {
            "AdaptiveCards\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AdaptiveCards\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse src tests --level=max",
        "check": [
            "@test",
            "@analyse",
            "@cs:check"
        ],
        "cs:fix": "php-cs-fixer fix --config=.php-cs-fixer.dist.php",
        "cs:check": "php-cs-fixer fix --dry-run --diff --config=.php-cs-fixer.dist.php"
    }
}
