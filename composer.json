{
    "name": "adaptivecards/adaptivecards-php",
    "description": "Fluent PHP builder that programmatically constructs Adaptive Card (v1.6) JSON and validates it against the official schema.",
    "type": "library",
    "license": "MIT",
    "keywords": ["adaptivecards", "adaptive-cards", "teams", "json", "builder"],
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "justinrainbow/json-schema": "^5.2 || ^6.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "AdaptiveCards\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AdaptiveCards\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
