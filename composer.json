{
    "name": "garis-kode/adaptivecard-php",
    "description": "Fluent PHP builder that programmatically constructs Adaptive Card (v1.6) JSON and validates it against the official schema.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "adaptivecards",
        "adaptive-cards",
        "microsoft-teams",
        "teams",
        "json",
        "builder"
    ],
    "homepage": "https://github.com/garis-kode/adaptivecard-php",
    "support": {
        "issues": "https://github.com/garis-kode/adaptivecard-php/issues",
        "source": "https://github.com/garis-kode/adaptivecard-php"
    },
    "authors": [
        {
            "name": "Garis Kode",
            "email": "office@gariskode.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "justinrainbow/json-schema": "^5.2 || ^6.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^2.1 || ^2.3"
    },
    "autoload": {
        "psr-4": {
            "AdaptiveCards\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AdaptiveCards\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse src tests --level=max",
        "check": [
            "@test",
            "@analyse"
        ]
    }
}
